# Copy this file to .env and fill in real values for local docker-compose use.
# NEVER commit the real .env file. This is a fictional-money demo — no real financial data.

# ---------- Application ----------
# Port the Spring Boot app listens on inside the container (hosting platforms override via PORT)
PORT=8080
SPRING_PROFILES_ACTIVE=docker

# ---------- MySQL (used by docker-compose to create the local DB container) ----------
MYSQL_DATABASE=banking_demo
MYSQL_USER=banking_app
MYSQL_PASSWORD=change_me_local_only
MYSQL_ROOT_PASSWORD=change_me_root_local_only

# ---------- Backend datasource (must match the MySQL block above for local docker-compose) ----------
DB_HOST=mysql
DB_PORT=3306
DB_NAME=banking_demo
DB_USER=banking_app
DB_PASSWORD=change_me_local_only
# Set to true only when connecting to a hosted MySQL that requires TLS (e.g. Aiven)
DB_USE_SSL=false
# Path to CA certificate bundle for hosted MySQL TLS verification (mounted at runtime, never committed)
DB_SSL_CA_PATH=

# ---------- Session cookies ----------
# Must be true in any real deployment (HTTPS). Only false for plain-HTTP local dev without TLS.
COOKIE_SECURE=false
# Lax is required for same-origin SPA + form posts; keep same-origin deployment to avoid needing None
COOKIE_SAME_SITE=Lax

# ---------- Admin bootstrap (only used on first startup when no admin exists) ----------
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@example.invalid
# Required, no default. Must satisfy backend password policy (min 12 chars).
ADMIN_BOOTSTRAP_PASSWORD=

# ---------- Demo financial limits (paise-free INR whole-rupee demo limits) ----------
DEMO_MAX_FUNDING_AMOUNT=100000
DEMO_MAX_TRANSFER_AMOUNT=100000
DEMO_DAILY_TRANSFER_LIMIT=500000

# ---------- Rate limiting (in-process, bounded; resets on restart) ----------
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=20
RATE_LIMIT_RECOVERY_PER_HOUR=10
# Set to true only if the app is genuinely behind a trusted reverse proxy (hosting platform edge)
TRUST_PROXY_HEADERS=false

# ---------- Backup encryption (local backup/restore tooling only, never committed) ----------
BACKUP_GPG_RECIPIENT=
